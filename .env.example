# Supabase: Settings > API Keys (or the Connect button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (starts with sb_publishable_). Older projects: the anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Secret key (starts with sb_secret_). Older projects: the service_role key. SERVER ONLY, never share or commit.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Paystack: Settings > API Keys & Webhooks (start with the sk_test_ key)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Your site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
